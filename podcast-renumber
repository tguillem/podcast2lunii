"""Number a downloaded podcast directory into play order (part 1 = track 1).

Episode order, highest priority first:
  1. An 'N/M' series in the item titles (e.g. "Tina ... 3/10 : ...") -> by N
     ascending, so part 1 is first, with any un-numbered extras (e.g. a
     "Bonus") kept after. The title number wins even when publication order
     would play the story backwards.
  2. Else the RSS item list reversed (feeds list newest first -> oldest first).
Each audio file is matched to a feed item by episode title, then gets:

  * items that are not part of the story moved aside into '.excluded/' by
    default (French 'Bande-annonce' trailers, plus un-numbered extras inside
    a numbered series); pass --no-drop-trailers to keep them in place.
    Nothing is ever deleted -- move a file back out of '.excluded/' to undo.
  * the redundant copy moved aside when the feed lists one episode twice
    (same title and same audio URL under two <guid>s, so yt-dlp's archive
    cannot skip it); this one always applies
  * tracknumber n/total (ID3 TRCK / MP4 trkn / vorbis TRACKNUMBER)
  * album tag set to the feed channel title (or --album NAME)
  * a date tag from the item's pubDate, only if the file has none
  * a filename rename to '<NN>_<name-without-old-numeric-prefix>'

MP3 tags are saved back as ID3v2.3 when that is what the file already used.

usage: podcast-renumber --feed URL_or_FILE [options] DIR
"""

import argparse
import os
import re
import sys
import unicodedata
from email.utils import parsedate_to_datetime
from pathlib import Path
from urllib.request import Request, urlopen

import mutagen
from defusedxml import ElementTree as ET
from defusedxml.common import DefusedXmlException
from mutagen.id3 import ID3, ID3NoHeaderError, TALB, TDRC, TRCK
from mutagen.mp4 import MP4

AUDIO_EXTS = {".mp3", ".m4a", ".m4b", ".ogg", ".oga", ".opus", ".flac"}
PREFIX_RE = re.compile(r"^\d+_")
EPNUM_RE = re.compile(r"(\d+)\s*/\s*(\d+)")
MAX_FEED_BYTES = 16 * 1024 * 1024
EXCLUDED_DIRNAME = ".excluded"
STAGING_GLOB = ".renum.*.tmp"


def read_capped(response, limit, source):
    """Read at most ``limit`` bytes, refusing a larger or unbounded response."""
    data = response.read(limit + 1)
    if len(data) > limit:
        sys.exit("error: response from %s exceeds %d bytes" % (source, limit))
    return data


def parse_pubdate(value):
    """A malformed <pubDate> must not abort the run; ordering falls back."""
    if not value:
        return None
    try:
        return parsedate_to_datetime(value)
    except (TypeError, ValueError):
        return None


def norm(s):
    """Normalize a title for matching: fold the chars yt-dlp filename
    sanitization substitutes (： ＂ ⧸ …), unify quotes, collapse spaces."""
    s = unicodedata.normalize("NFKC", s)  # ：＂＊？＜＞ -> ascii
    s = s.replace("⧸", "/").replace("⧹", "\\")
    s = s.replace("’", "'").replace("‘", "'")
    s = s.replace("“", '"').replace("”", '"')
    return " ".join(s.casefold().split())


def load_feed(src):
    """Return (channel_title, items oldest-first: [{title, norm, pub, seq}])."""
    if re.match(r"^https?://", src):
        req = Request(src, headers={"User-Agent": "podcast-renumber/1.0"})
        with urlopen(req, timeout=30) as response:
            data = read_capped(response, MAX_FEED_BYTES, src)
    else:
        data = Path(src).read_bytes()
    try:
        channel = ET.fromstring(data).find("channel")
    except (ET.ParseError, DefusedXmlException, ValueError) as exc:
        sys.exit("error: could not parse feed %s: %s" % (src, exc))
    if channel is None:
        sys.exit("error: not an RSS feed (no <channel>): %s" % src)
    items = []
    for it in channel.findall("item"):
        title = (it.findtext("title") or "").strip()
        if not title:
            sys.exit("error: feed item without a title")
        pubdate = it.findtext("pubDate")
        enc = it.find("enclosure")
        items.append({
            "title": title,
            "norm": norm(title),
            "enc": (enc.get("url") or "").strip() if enc is not None else "",
            "pub": parse_pubdate(pubdate),
        })

    # Episode order, highest priority first:
    #   1. an 'N/M' series in the titles -> by N ascending (part 1 first),
    #      with un-numbered extras (e.g. a "Bonus") kept after, oldest first.
    #   2. else the RSS list reversed (newest-first feed -> oldest first).
    ranks = None
    dominant, marks = series_marks(items)
    if (dominant is not None
            and sum(m is not None for m in marks) * 2 > len(items)
            and is_part_series(items, marks, dominant)):
        numbered = sorted((i for i, m in enumerate(marks) if m),
                          key=lambda i: int(marks[i].group(1)))
        num_set = set(numbered)
        rest = [i for i in range(len(items) - 1, -1, -1) if i not in num_set]
        for i in rest:
            items[i]["extra"] = True       # un-numbered item in a numbered story
        ranks = numbered + rest            # extras last, only with --no-drop-trailers

    if ranks is None:
        ranks = range(len(items) - 1, -1, -1)
    for seq, i in enumerate(ranks):
        items[i]["seq"] = seq
    order_embedded_arcs(items)

    return (channel.findtext("title") or "").strip(), items


def series_marks(items):
    """Pick the 'N/M' token in each title that looks like a part marker.

    A title can carry two ("Serie 3/4 : le carnet du 04/03"), so prefer the
    token whose denominator the rest of the feed agrees on.
    """
    tokens = [list(EPNUM_RE.finditer(it["norm"])) for it in items]
    counts = {}
    for row in tokens:
        for match in row:
            counts[match.group(2)] = counts.get(match.group(2), 0) + 1
    if not counts:
        return None, []
    dominant = max(counts, key=lambda key: (counts[key], -int(key)))
    marks = [next((m for m in row if m.group(2) == dominant), None) for row in tokens]
    return dominant, marks


def looks_like_dates(items, marks):
    """True when every checkable 'N/M' is just that item's publication date."""
    checkable = [(items[i], m) for i, m in enumerate(marks) if m and items[i].get("pub")]
    if not checkable:
        return False
    return all(int(m.group(1)) == it["pub"].day
               and int(m.group(2)) == it["pub"].month for it, m in checkable)


def is_part_series(items, marks, dominant):
    """True when the marked items really are parts 1..M of one story.

    Two independent signals keep dates out, because a date parses as a part
    number: "Bulletin du 04/03" is N=4, M=3. Requiring every part instead
    would reject the common case, since a feed usually exposes only a window
    of a long series.
    """
    total_parts = int(dominant)
    if total_parts < 2:
        return False
    ns = [int(m.group(1)) for m in marks if m]
    if len(ns) < 2 or len(set(ns)) != len(ns):
        return False
    if any(n < 1 or n > total_parts for n in ns):
        return False
    if looks_like_dates(items, marks):
        return False
    # A real story's leftovers are things like a "Bonus", carrying no N/M at
    # all. A misread date feed's leftovers are simply other months.
    return not any(m is None and EPNUM_RE.search(items[i]["norm"])
                   for i, m in enumerate(marks))


def order_embedded_arcs(items):
    """Put each numbered arc into part order, in the slots it already holds.

    A feed can be an anthology with an arc inside it -- a hundred standalone
    episodes around a 16-part one, say -- far too small a minority for the
    whole-feed series test. Reordering only within the positions the arc
    already occupies leaves every other episode where the RSS placed it.
    """
    groups = {}
    for i, item in enumerate(items):
        if item.get("extra"):
            continue
        for match in EPNUM_RE.finditer(item["norm"]):
            groups.setdefault(match.group(2), {}).setdefault(i, match)
    for denominator, members in groups.items():
        total = int(denominator)
        parts = [int(match.group(1)) for match in members.values()]
        if total < 2 or len(members) < 2:
            continue
        if len(set(parts)) != len(parts):
            continue                       # ambiguous: two arcs share a shape
        if any(part < 1 or part > total for part in parts):
            continue                       # not part numbers at all
        marks = [None] * len(items)
        for i, match in members.items():
            marks[i] = match
        if looks_like_dates(items, marks):
            continue
        slots = sorted(items[i]["seq"] for i in members)
        for slot, i in zip(slots, sorted(members,
                                         key=lambda i: int(members[i].group(1)))):
            items[i]["seq"] = slot


def title_candidates(path, tags):
    cands = []
    if tags:
        t = (tags.get("title") or [""])[0]
        if t:
            cands.append(t)
    cands.append(PREFIX_RE.sub("", path.stem))
    return cands


def compile_drop_patterns(args):
    if args.no_drop_trailers:
        return []
    return [re.compile(r"^bande[- ]annonce\b", re.I)]


def should_drop(patterns, *titles):
    return any(p.search(norm(t)) for p in patterns for t in titles if t)


def move_excluded(path, dest_dir):
    """Move a non-story file out of the numbering set. Never deletes."""
    if dest_dir.is_symlink() or (dest_dir.exists() and not dest_dir.is_dir()):
        sys.exit("error: %s must be a real directory" % dest_dir)
    dest_dir.mkdir(exist_ok=True)
    target = dest_dir / path.name
    counter = 1
    while target.exists():
        target = dest_dir / ("%s.%d%s" % (path.stem, counter, path.suffix))
        counter += 1
    try:
        path.rename(target)
    except OSError as exc:
        sys.exit("error: could not move %s into %s/: %s" % (path.name, dest_dir.name, exc))
    return target


def save_mp3(path, n, total, album, pub):
    try:
        raw_version = ID3(path, translate=False).version
        tag = ID3(path)
    except ID3NoHeaderError:
        raw_version = (2, 3, 0)
        tag = ID3()
    tag.setall("TRCK", [TRCK(encoding=0, text=["%d/%d" % (n, total)])])
    if album is not None:
        enc = 0 if album.isascii() else 1  # latin-1 / UTF-16: both v2.3-safe
        tag.setall("TALB", [TALB(encoding=enc, text=[album])])
    if not tag.getall("TDRC") and pub is not None:
        tag.setall("TDRC", [TDRC(encoding=0, text=[pub.date().isoformat()])])
    if raw_version < (2, 4, 0):
        tag.update_to_v23()
        tag.save(path, v2_version=3)
    else:
        tag.save(path)


def save_mp4(path, n, total, album, pub):
    tag = MP4(path)
    tag["trkn"] = [(n, total)]
    if album is not None:
        tag["\xa9alb"] = [album]
    if "\xa9day" not in tag and pub is not None:
        tag["\xa9day"] = [pub.date().isoformat()]
    tag.save()


def save_other(path, n, total, album, pub):
    tag = mutagen.File(path, easy=True)
    tag["tracknumber"] = ["%d/%d" % (n, total)]
    if album is not None:
        tag["album"] = [album]
    if not tag.get("date") and pub is not None:
        tag["date"] = [pub.date().isoformat()]
    tag.save()


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("dir", type=Path)
    ap.add_argument("--feed", required=True, metavar="URL_or_FILE",
                    help="podcast RSS feed (source of episode order)")
    ap.add_argument("--album", metavar="NAME",
                    help="album tag to set (default: feed channel title)")
    ap.add_argument("--keep-album", action="store_true",
                    help="leave album tags untouched")
    ap.add_argument("--allow-unmatched", action="store_true",
                    help="files not found in the feed are numbered first "
                         "(by existing track tag, then mtime) instead of aborting")
    ap.add_argument("--drop-trailers", action="store_false",
                    dest="no_drop_trailers",
                    help="move non-story items aside into .excluded/: "
                         "'Bande-annonce' trailers and un-numbered extras "
                         "inside a numbered series (default; never deletes)")
    ap.add_argument("--no-drop-trailers", action="store_true",
                    help="keep 'Bande-annonce' trailers and un-numbered extras "
                         "inside a numbered series")
    ap.set_defaults(no_drop_trailers=False)
    ap.add_argument("-n", "--dry-run", action="store_true",
                    help="print the plan, change nothing")
    args = ap.parse_args()

    if not args.dir.is_dir():
        sys.exit("error: not a directory: %s" % args.dir)

    chan_title, items = load_feed(args.feed)
    drop_patterns = compile_drop_patterns(args)
    by_title = {}
    for it in items:
        by_title.setdefault(it["norm"], []).append(it)

    # A feed can list the same episode twice under two <guid>s (same title,
    # same enclosure), which yt-dlp's archive cannot dedupe: keep the item
    # that plays first and let the redundant download be dropped below.
    # Same title but different audio stays ambiguous, and is an error.
    dup_titles = set()
    for key, hits in by_title.items():
        if len(hits) > 1 and hits[0]["enc"] and all(
                it["enc"] == hits[0]["enc"] for it in hits):
            by_title[key] = [min(hits, key=lambda it: it["seq"])]
            dup_titles.add(key)

    album = None if args.keep_album else (args.album or chan_title or None)

    files = sorted(p for p in args.dir.iterdir()
                   if p.is_file() and p.suffix.lower() in AUDIO_EXTS)
    # Checked before the empty-directory exit: staging names carry no audio
    # suffix, so a run interrupted after staging everything looks like an empty
    # directory and would otherwise report that instead of the recoverable files.
    stale = sorted(args.dir.glob(STAGING_GLOB))
    if stale:
        sys.exit("error: %d staging file(s) left by an interrupted run; "
                 "rename them back before re-running:\n  %s"
                 % (len(stale), "\n  ".join(p.name for p in stale)))

    if not files:
        sys.exit("error: no audio files in %s" % args.dir)

    matched, unmatched, excluded, claimed = [], [], [], {}
    for path in files:
        tags = mutagen.File(path, easy=True)
        if tags is None:
            sys.exit("error: unreadable audio file: %s" % path.name)
        cands = title_candidates(path, tags)
        item = None
        for cand in cands:
            hits = by_title.get(norm(cand), [])
            if len(hits) > 1:
                sys.exit("error: title %r is ambiguous in the feed (%d items)"
                         % (cand, len(hits)))
            if hits:
                item = hits[0]
                break
        if item is None:
            if should_drop(drop_patterns, *cands):
                excluded.append((path, None))
                continue
            unmatched.append((path, tags))
            continue
        if should_drop(drop_patterns, item["title"], *cands) or (
                item.get("extra") and not args.no_drop_trailers):
            excluded.append((path, item))
            continue
        if item["seq"] in claimed:
            if item["norm"] in dup_titles:  # duplicate feed entry, same audio
                excluded.append((path, item))
                continue
            sys.exit("error: %s and %s both match feed item %r"
                     % (claimed[item["seq"]].name, path.name, item["title"]))
        claimed[item["seq"]] = path
        matched.append((path, item))

    if unmatched and not args.allow_unmatched:
        sys.exit("error: %d file(s) not found in the feed "
                 "(use --allow-unmatched to number them first):\n  %s"
                 % (len(unmatched), "\n  ".join(p.name for p, _ in unmatched)))

    def unmatched_key(entry):
        path, tags = entry
        trck = (tags.get("tracknumber") or [""])[0].split("/")[0]
        return (0, int(trck)) if trck.isdigit() else (1, path.stat().st_mtime)

    ordered = [(p, None) for p, _ in sorted(unmatched, key=unmatched_key)]
    ordered += [(p, it) for p, it in sorted(matched, key=lambda e: e[1]["seq"])]

    total = len(ordered)
    width = max(2, len(str(total)))
    plan = []
    for n, (path, item) in enumerate(ordered, 1):
        newname = "%0*d_%s%s" % (width, n, PREFIX_RE.sub("", path.stem),
                                 path.suffix)
        plan.append((n, path, item, newname))

    finals = [newname for _, _, _, newname in plan]
    if len(set(finals)) != len(finals):
        sys.exit("error: renaming would collide (files differing only in "
                 "their numeric prefix)")

    namew = max(len(p.name) for p in files)
    for path, item in excluded:
        title = item["title"] if item else PREFIX_RE.sub("", path.stem)
        print("skip  %s  %-*s (%s) -> %s/" % (
            item["pub"].date().isoformat() if item and item["pub"] else "—",
            namew,
            path.name,
            title,
            EXCLUDED_DIRNAME,
        ))
    for n, path, item, newname in plan:
        pub = item["pub"].date().isoformat() if item and item["pub"] else "—"
        print("%*d  %s  %-*s -> %s" % (width, n, pub, namew, path.name, newname))
    if album is not None:
        print("album: %r on all %d files" % (album, total))
    if args.dry_run:
        print("dry run: nothing changed")
        return

    for n, path, item, _ in plan:
        pub = item["pub"] if item else None
        ext = path.suffix.lower()
        if ext == ".mp3":
            save_mp3(path, n, total, album, pub)
        elif ext in (".m4a", ".m4b"):
            save_mp4(path, n, total, album, pub)
        else:
            save_other(path, n, total, album, pub)

    for path, _ in excluded:
        move_excluded(path, args.dir / EXCLUDED_DIRNAME)

    # Refuse before touching anything if a destination is already occupied by
    # a file that is not itself part of the plan.
    sources = {path for _, path, _, _ in plan}
    for _, path, _, newname in plan:
        final = path.with_name(newname)
        if final.exists() and final not in sources:
            sys.exit("error: refusing to overwrite %s" % final)

    # Two reversible phases: stage every rename under a unique name, then move
    # each into place. A raised exception rewinds whatever already happened.
    # A SIGKILL, or a failure inside the rewind itself, can still leave staging
    # files behind -- the next run refuses to start and names them.
    staged = []
    try:
        for i, (_, path, _, newname) in enumerate(plan):
            if path.name == newname:
                continue
            staging = path.with_name(".renum.%d.%d.tmp" % (os.getpid(), i))
            if staging.exists():
                raise FileExistsError("staging file in the way: %s" % staging)
            staged.append((staging, path, path.with_name(newname)))
            path.rename(staging)          # intent recorded before the move
        for staging, origin, final in staged:
            staging.rename(final)
    except BaseException:
        # Undo committed moves first, then un-stage. Decide from the filesystem
        # rather than from a log of what succeeded: an interrupt can land
        # between a rename and any bookkeeping, so only on-disk state is
        # trustworthy, and a stale log can rename one file over another.
        # Repeat to a fixpoint: with an interlocking cycle of renames, one
        # pass frees a name that lets the next entry move, so a single pass
        # stops halfway and leaves a file under another file's name.
        while True:
            moved = False
            for staging, origin, final in reversed(staged):
                if final.exists() and not staging.exists() and not origin.exists():
                    final.rename(origin)
                    moved = True
                elif staging.exists() and not origin.exists():
                    staging.rename(origin)
                    moved = True
            if not moved:
                break
        raise

    print("done: %d files tagged, %d renamed, %d moved to %s/"
          % (total, len(staged), len(excluded), EXCLUDED_DIRNAME))


if __name__ == "__main__":
    main()
